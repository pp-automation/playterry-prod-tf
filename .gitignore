# Local .terraform directories
**/.terraform/*
.terraform.lock.hcl.bak

# State files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files with secrets / environment values
*.tfvars
*.tfvars.json
!*.tfvars.example

# CLI config
.terraformrc
terraform.rc

# Plan output
*.tfplan
plan.out
