# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "westeurope"

# --- Point-to-Site VPN -------------------------------------------------------
vpn = {
  aad_tenant_id = "11111111-1111-1111-1111-111111111111"
  # sku                  = "VpnGw1"
  # client_address_space = ["172.16.0.0/24"]
}

# --- AKS -------------------------------------------------------------------
# kubernetes_version = "1.30"
aks_admin_group_object_ids = [
  # "22222222-2222-2222-2222-222222222222", # Entra ID group -> cluster admins
]

# aks_defaults = {
#   system_node_vm_size   = "Standard_D4s_v5"
#   workload_node_vm_size = "Standard_D8s_v5"
#   private_cluster_enabled = true
# }

# --- SQL Managed Instance -------------------------------------------------
sql_managed_instance = {
  # administrator_login          = "playterryadmin"
  # administrator_login_password = "<leave unset to auto-generate>"
  # vcores                       = 4
  # storage_size_in_gb           = 256
}

# Databases to create on the managed instance. Empty until the app databases
# are decided. Example (names taken from another environment):
sql_databases = {
  # DailyActionsDB        = {}
  # DBA                   = {}
  # ProgressPlayDBArchive = { short_term_retention_days = 14 }
  # SystemParametersDB    = {}
  # WiseSpinDB            = {}
}

# --- Managed Redis (Azure Cache for Redis) ---------------------------
# Defaults to Standard C3 = 6 GB (covers the ~4 GB estimate). Private
# endpoint only. Move up to Premium (zones + persistence) with:
#   redis = { sku_name = "Premium", family = "P", capacity = 1, zones = ["1","2","3"] }
redis = {
  # sku_name = "Standard"
  # family   = "C"
  # capacity = 3
}

# --- IIS pool -----------------------------------------------------------
iis = {
  # instance_count = 2
  # vm_size        = "Standard_D2s_v5"
  # admin_password = "<leave unset to auto-generate>"
}

# --- Application Gateway -----------------------------------------------
application_gateway = {
  # sku_name   = "WAF_v2"
  # sku_tier   = "WAF_v2"
  # enable_waf = true
  # waf_mode   = "Prevention"
}

tags = {
  owner       = "platform-team"
  cost_center = "gaming"
}
